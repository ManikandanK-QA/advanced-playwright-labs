{
  "name": "advanced-playwright-labs",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright labs for visual regression, network simulation, performance budgets and browser security testing.",
  "author": "Manikandan Kandasamy",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:visual": "playwright test --project=visual",
    "test:network": "playwright test --project=network",
    "test:performance": "playwright test --project=performance",
    "test:security": "playwright test --project=security",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "site": "node apps/lab-site/server.mjs",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.74.0"
  }
}
